{
  "$comment": "本文件是「机器可读层」：任何 AI 客户端可以不读 Markdown，直接解析这里拿到能力清单。改命令时**必须同步这里**，否则 scripts/selftest.mjs 的一致性门会红。",
  "schemaVersion": "1",
  "contractVersion": "1.5.0",
  "pkgVersion": "0.9.0",
  "entrypoints": {
    "cli": "cxa",
    "cliAlias": "cxstudy",
    "cliFile": "src/cli.mjs",
    "mcp": "node mcp/server.mjs",
    "mcpFile": "mcp/server.mjs",
    "skill": "dsh/skills/cxstudy/SKILL.md",
    "contract": "AGENT-CONTRACT.md",
    "llms": "llms.txt",
    "readme": "README.md"
  },
  "requirements": {
    "node": ">=22.0.0",
    "dependencies": "零第三方依赖",
    "network": "需要访问 chaoxing.com（无代理时可直连）"
  },
  "capabilities": [
    {
      "id": "auth",
      "cli": "cxa auth",
      "mcp": "cx_status",
      "kind": "setup",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "会话自检 / 登录 / 查看 cookie 状态。任何异常都先跑这个。",
      "inputs": {
        "required": [],
        "optional": [
          "login",
          "status",
          "import <文件>"
        ],
        "onMissing": "无子命令时打印用法"
      },
      "returns": {
        "ok": "{ok, loggedIn, cookieCount, probe}",
        "fail": "退出码非 0"
      }
    },
    {
      "id": "courses",
      "cli": "cxa courses",
      "mcp": "cx_courses",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "课程列表（含 courseId / clazzId / cpi，后续命令都要用）。",
      "inputs": {
        "required": [],
        "optional": [
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, courses:[{courseId,classId,personId,name,teacher}], total}",
        "fail": "退出码非 0，stderr 以 ✖ 开头"
      }
    },
    {
      "id": "chapters",
      "cli": "cxa chapters",
      "mcp": "cx_chapters",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "章节与任务点进度。需要浏览器。",
      "inputs": {
        "required": [
          "--cid",
          "--clz"
        ],
        "optional": [
          "--cpi",
          "--json"
        ],
        "onMissing": "报错退出，不猜课程"
      },
      "returns": {
        "ok": "{ok, chapters:[{knowledgeId,name,jobs:[{jobid,type,status}]}], progress:{done,total}}",
        "caveat": "需要浏览器，约 5-10 秒"
      }
    },
    {
      "id": "exams",
      "cli": "cxa exams",
      "mcp": "cx_exams",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "考试安排（默认只列未结束的，--all 看全部）。",
      "inputs": {
        "required": [],
        "optional": [
          "--all",
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, exams:[{courseName,name,startTime,endTime,status}]}",
        "caveat": "默认只返回未结束的考试"
      }
    },
    {
      "id": "notices",
      "cli": "cxa notices",
      "mcp": "cx_notices",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "通知中心 + 未交作业（--work）。",
      "inputs": {
        "required": [],
        "optional": [
          "--work",
          "--all",
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, notices:[{title,courseName,type,url}]}",
        "caveat": "--work 只返回作业/考试入口"
      }
    },
    {
      "id": "materials",
      "cli": "cxa materials",
      "mcp": "cx_materials",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "资料区：列 / 递归搜（匹配完整路径）/ 下载到本地。",
      "inputs": {
        "required": [
          "--course 或 --cid"
        ],
        "optional": [
          "--find <关键词>",
          "--download <目录>",
          "--json"
        ],
        "onMissing": "报错退出"
      },
      "returns": {
        "ok": "{ok, files:[{name,path,size}], dirs[]}",
        "caveat": "--download 会写磁盘"
      }
    },
    {
      "id": "schedule",
      "cli": "cxa schedule",
      "mcp": "cx_schedule",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "课表：当前周 / 指定周 / 今天 / 明天 + 空闲时段 / 导出 .ics。",
      "inputs": {
        "required": [],
        "optional": [
          "--week n",
          "--today",
          "--tomorrow",
          "--ics <目录>",
          "--alarm <分钟>",
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, week, lessons:[{name,teacher,room,weekday,sections,startTime,endTime}]}",
        "caveat": "--ics 会写 .ics 文件"
      }
    },
    {
      "id": "plan",
      "cli": "cxa plan",
      "mcp": null,
      "kind": "read",
      "since": "0.2.0",
      "stability": "stable",
      "summary": "未来 N 天：课 + 考试 + 空闲时段合并视图。",
      "inputs": {
        "required": [],
        "optional": [
          "--days 14",
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "**没有 --json**（输出是文本日程表）",
        "caveat": "需要登录态"
      }
    },
    {
      "id": "brief",
      "cli": "cxa brief",
      "mcp": null,
      "kind": "read",
      "since": "0.2.0",
      "stability": "stable",
      "summary": "一段可以直接粘给 AI 的 Markdown 简报。",
      "inputs": {
        "required": [],
        "optional": [
          "--days 7"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "Markdown 文本（**没有 --json**，它就是给 AI 直接粘的简报）"
      }
    },
    {
      "id": "exam",
      "cli": "cxa exam",
      "mcp": null,
      "kind": "read",
      "since": "0.2.0",
      "stability": "stable",
      "summary": "备考档案：课件按章归组 + 分级证据（作业/教案/大纲/习题/视频时长）+ 考试倒计时 + 老师通知 + 给 AI 的提示词。",
      "inputs": {
        "required": [
          "--course <名>"
        ],
        "optional": [
          "--out <目录>",
          "--no-video",
          "--json"
        ],
        "onMissing": "报错退出"
      },
      "returns": {
        "ok": "{ok, course, evidence:{homework[],outline[],exercises[],videoMinutes}, degraded[]}",
        "caveat": "--out 会写 Markdown 文件"
      }
    },
    {
      "id": "info",
      "cli": "cxa info",
      "mcp": null,
      "kind": "read",
      "since": "0.3.0",
      "stability": "stable",
      "summary": "外部资讯：四六级 / 计算机等级 / 考研 / 考公的官方入口与一般规律；sources 子命令列外部源模板并打印加源提示词。",
      "inputs": {
        "required": [
          "<主题>"
        ],
        "optional": [
          "sources"
        ],
        "onMissing": "报错并列出可用主题（cet/ncre/kaoyan/gongkao/school）"
      },
      "returns": {
        "ok": "Markdown / 纯文本（**没有 --json**；只给官方链接与一般规律）",
        "fail": "未知主题时退出码非 0，并列出可用主题"
      }
    },
    {
      "id": "pan",
      "cli": "cxa pan",
      "mcp": null,
      "kind": "read",
      "since": "0.3.0",
      "stability": "beta",
      "summary": "云盘根目录列表（需 CDP 现取 enc，约 8 秒）。",
      "inputs": {
        "required": [],
        "optional": [
          "--json"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, total, items:[{name,size,isDir}]}",
        "caveat": "需要浏览器，约 8 秒（服务端签名的 enc 必须抓活的）"
      }
    },
    {
      "id": "play",
      "cli": "cxa play",
      "mcp": "cx_play",
      "kind": "write",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "后台静默连播课程视频。会改变平台上的观看进度，跑之前应让用户确认。",
      "caveat": "真正的记账需要四条件链（studentcourse 跳转 + enc 签名 + 真实浏览器 + 关后台节流），本命令已实现。",
      "inputs": {
        "required": [
          "--cid",
          "--clz"
        ],
        "optional": [
          "--kid",
          "--limit",
          "--rate",
          "--dry-run",
          "--headed",
          "--cpi"
        ],
        "onMissing": "报错退出"
      },
      "returns": {
        "ok": "{ok, played[], skipped[], elapsedSec}",
        "caveat": "**耗时≈视频总时长**；写类，执行前必须让用户确认"
      }
    },
    {
      "id": "check",
      "cli": "cxa check",
      "mcp": "cx_gates",
      "kind": "read",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "5 道判据门（env / auth / target / reachable / progress），红项带 evidence。查的是**运行时环境**。",
      "inputs": {
        "required": [],
        "optional": [
          "--cid",
          "--clz",
          "--json"
        ],
        "onMissing": "无必填参数（会尽量自动推断目标）"
      },
      "returns": {
        "ok": "{ok, gates:[{id,status,message,evidence}], summary:{total,pass,fail,skip}}",
        "fail": "退出码 3（有红门）或 0（全绿）；--json 时只输出 JSON，不混文本",
        "caveat": "status 三态：pass/fail/skip，skip 不算通过"
      }
    },
    {
      "id": "audit",
      "cli": "cxa audit",
      "mcp": null,
      "kind": "read",
      "since": "0.5.0",
      "stability": "stable",
      "summary": "交付面审计：文档里的数字 / 清单 / 过时结论 vs 实现。查的是**仓库自洽性**，与 check 互补。`--fix` 只修能唯一确定的（版本号同步），其余显形要求人改。",
      "inputs": {
        "required": [],
        "optional": [
          "--json",
          "--fix",
          "--with-tests"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "{ok, groups:[{name,results[{label,verdict,detail}]}], pass, fail, skip}",
        "caveat": "verdict 三态：pass/fail/skip，skip 不算通过"
      }
    },
    {
      "id": "notify",
      "cli": "cxa notify",
      "mcp": null,
      "kind": "write",
      "since": "0.2.0",
      "stability": "stable",
      "summary": "推送到手机：企业微信 / 飞书 / 钉钉 / Server酱 / PushPlus。会向外部服务发请求。",
      "inputs": {
        "required": [
          "<channels|set|status|test|brief>"
        ],
        "optional": [],
        "onMissing": "报错并列出可用子命令"
      },
      "returns": {
        "ok": "{ok, channel, delivered, businessCode}",
        "fail": "HTTP 200 但 errcode≠0 也算失败",
        "caveat": "**外发动作**：会给用户手机推送，执行前确认"
      }
    },
    {
      "id": "mcp",
      "cli": "cxa mcp",
      "mcp": null,
      "kind": "setup",
      "since": "0.1.0",
      "stability": "stable",
      "summary": "启动 MCP server（stdio，newline-delimited JSON-RPC）。",
      "inputs": {
        "required": [],
        "optional": [],
        "onMissing": "无参数（走 stdin/stdout）"
      },
      "returns": {
        "ok": "stdio JSON-RPC 流（不是一次性 JSON）",
        "caveat": "给宿主调用，人不要直接跑"
      }
    },
    {
      "id": "http",
      "cli": null,
      "mcp": "cx_http",
      "kind": "write",
      "since": "0.1.0",
      "stability": "beta",
      "summary": "带登录态发任意学习通请求（万能兜底）。没有对应 CLI 命令，只能通过 MCP 用。",
      "inputs": {
        "required": [
          "url"
        ],
        "optional": [],
        "onMissing": "报错退出"
      },
      "returns": {
        "ok": "{ok, status, body}",
        "fail": "网络/鉴权失败时 ok:false",
        "caveat": "**只读兜底**，不做写操作"
      }
    },
    {
      "id": "heal",
      "cli": "cxa heal",
      "mcp": null,
      "kind": "write",
      "since": "0.7.0",
      "stability": "beta",
      "summary": "自愈：按配方自动修改仓库自己的文件（版本号同步 / 文档数字同步 / manifest 补骨架）。默认预演不碰文件；--apply --yes 才真改，改完立刻验证，不过自动回滚。kind=write 因为会改源码。",
      "inputs": {
        "required": [],
        "optional": [
          "--apply --yes",
          "--commit",
          "--with-tests",
          "--dry-run（默认）"
        ],
        "onMissing": "无必填参数"
      },
      "returns": {
        "ok": "**没有 --json**（输出是给人读的自愈报告）",
        "caveat": "改源码：默认 dry-run；--apply 还要 --yes；验证不过自动回滚"
      }
    },
    {
      "id": "feedback",
      "cli": "cxa feedback",
      "mcp": null,
      "kind": "write",
      "since": "0.9.0",
      "stability": "beta",
      "summary": "标记一次使用的好坏（ok/bad + 理由）。写进 usage.jsonl 的 feedback 字段，供 Skill 健康统计；需主动调，所以覆盖率取决于自觉。",
      "inputs": {
        "required": [
          "ok|bad"
        ],
        "optional": [
          "理由"
        ],
        "onMissing": "打印用法并退出码 1"
      },
      "returns": {
        "ok": "文本确认（成功/失败都不返回 JSON）",
        "caveat": "只写本地 usage.jsonl，不联网、不上报"
      }
    }
  ],
  "kindMeaning": {
    "read": "只读，不改变平台状态，可以自行跑",
    "write": "会改变平台状态或向外部服务发请求，跑之前应告知用户",
    "setup": "安装/启动类，不影响平台数据"
  },
  "boundaries": [
    {
      "id": "no-fake-progress",
      "rule": "不伪造任务点完成状态、不伪造学习时长（不构造 multimedia/log 上报）"
    },
    {
      "id": "no-exam-cheating",
      "rule": "不做考试中的实时答题；考前生成复习材料才是本工具的用途"
    },
    {
      "id": "no-captcha-bypass",
      "rule": "不绕过验证码、设备指纹、行为风控"
    },
    {
      "id": "no-multi-account",
      "rule": "只服务使用者自己的账号，不做多账号批量"
    },
    {
      "id": "no-pirated-materials",
      "rule": "不分发盗版教材、不维护题库服务器"
    },
    {
      "id": "no-invented-focus",
      "rule": "不编造\"复习重点\"：没有考纲时给分级证据 + 让用户的 AI 结合证据推断"
    },
    {
      "id": "no-autoplay-as-substitute",
      "rule": "自动播放不等于代替学习：多数院校把委托工具自动播放/刷课列为学术不端，使用者须自行确认校规并承担后果；本项目不宣称可免除本人学习时长"
    }
  ],
  "deprecated": [
    {
      "from": "cxstudy",
      "to": "cxa",
      "since": "0.3.0",
      "removeAt": null,
      "note": "CLI 旧别名，两个命令等价，随时可能移除"
    },
    {
      "from": "cxstudy-toolkit",
      "to": "chaoxing-assistant",
      "since": "0.3.0",
      "removeAt": null,
      "note": "仓库旧名，GitHub 会自动重定向"
    }
  ],
  "evolutionRules": {
    "addCommand": "在 capabilities 加一条（带 since）→ 一致性门自动要求 SKILL.md 也提到它",
    "renameCommand": "旧名进 deprecated（带 since + removeAt）→ 新旧都能跑 → 门不红",
    "removeCommand": "必须先 deprecated 至少一个 minor 版本，removeAt 写明删除版本",
    "breakingChange": "升 contractVersion；必须在 CHANGELOG.md 顶格写明"
  },
  "distribution": {
    "note": "用户大概率在国内，主仓库在 GitHub。不写清楚怎么拿到 = 没有分发。详见 docs/INSTALL-WITHOUT-GH.md",
    "paths": [
      {
        "id": "offline-zip",
        "how": "node scripts/make-offline-zip.mjs",
        "yields": "dist/chaoxing-assistant-<ver>-offline.zip（约 365 KB）",
        "needs": "有人能 clone 一次",
        "caveat": "要人传给你；包内自带 README-FIRST.txt"
      },
      {
        "id": "mirror",
        "how": "node scripts/mirror-push.mjs --to <Gitee/GitCode 地址>",
        "yields": "一个可直连 clone 的镜像",
        "needs": "在镜像站建一个空仓库",
        "caveat": "不自动跟主仓库同步，主仓库更新要再推一次"
      },
      {
        "id": "jsdelivr",
        "how": "https://cdn.jsdelivr.net/gh/<user>/<repo>@<ref>/<path>",
        "yields": "单个文件",
        "needs": "只要能打开网页",
        "caveat": "只能下单文件，不能 clone，不下 .git 历史"
      }
    ]
  }
}
