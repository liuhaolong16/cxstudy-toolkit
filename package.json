{
  "name": "cxstudy-toolkit",
  "version": "0.2.0",
  "description": "超星学习通小助手：刷课过任务点、整理课程资料、按考试生成备考档案。不伪造任何学习记录。",
  "type": "module",
  "bin": {
    "cxa": "./src/cli.mjs",
    "cxstudy": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./mcp": "./mcp/server.mjs"
  },
  "files": [
    "src",
    "mcp",
    "dsh",
    "docs",
    "README.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node src/cli.mjs check",
    "scan": "node scripts/scan-secrets.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "keywords": [
    "chaoxing",
    "xuexitong",
    "mcp",
    "automation",
    "headless",
    "education",
    "study-assistant",
    "exam-prep"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhaolong16/chaoxing-assistant.git"
  }
}
